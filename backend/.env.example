# Use a Neon URL with sslmode=require in deployment.
DATABASE_URL=sqlite:///./edumate.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Set locally; never commit a real password.
DEMO_PASSWORD=replace-with-a-demo-password-of-at-least-12-characters
